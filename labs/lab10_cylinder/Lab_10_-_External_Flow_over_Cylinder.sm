    <region left="18" top="6782" width="740" height="32" color="#000000" fontSize="12">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 12px; font-weight: bold;">Drag Coefficient from Literature</p>
        </content>
      </text>
    </region>
    <region left="18" top="6826" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Smooth cylinder values read from Figure 15-34 of Cengel et al.</p>
        </content>
      </text>
    </region>
