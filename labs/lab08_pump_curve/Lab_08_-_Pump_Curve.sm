    <region left="18" top="1478" width="760" height="27" color="#000000" fontSize="10">
      <text lang="eng" fontFamily="Arial" fontSize="10">
        <content>
          <p>Lab 6 system curve (Part B of Lab06_PipeFriction_2.xlsx), tests 1 to 8 at 100% down to 30% of the maximum flowrate</p>
        </content>
      </text>
    </region>
    <region left="18" top="1513" width="260" height="180" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">Q.system</e>
          <e type="operand">3.5</e>
          <e type="operand">3.125</e>
          <e type="operand">2.75</e>
          <e type="operand">2.5</e>
