  <regions type="content">
    <region left="18" top="0" width="740" height="32" color="#000000" fontSize="12">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 12px; font-weight: bold;">Grant Bellon</p>
        </content>
      </text>
    </region>
    <region left="18" top="44" width="740" height="32" color="#000000" fontSize="12">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 12px; font-weight: bold;">Drive Wheel Torque Calculation</p>
        </content>
      </text>
    </region>
    <region left="18" top="98" width="740" height="66" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>The torque the drive motor must supply at the wheel is the wheel radius times the total force needed to overcome rolling resistance, climb the incline, and accelerate the load. A safety factor is then applied to get the design torque.</p>
        </content>
      </text>
    </region>
    <region left="18" top="184" width="740" height="32" color="#000000" fontSize="12">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 12px; font-weight: bold;">Given Data</p>
        </content>
      </text>
    </region>
    <region left="18" top="228" width="120" height="30" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">R</e>
          <e type="operand">48</e>
          <e type="operand" style="unit">mm</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="276" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Wheel radius</p>
        </content>
      </text>
    </region>
    <region left="18" top="318" width="110" height="35" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">C.f</e>
          <e type="operand">0.02</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="371" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Rolling resistance coefficient (rubber on concrete)</p>
        </content>
      </text>
    </region>
    <region left="18" top="413" width="120" height="30" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">W</e>
          <e type="operand">1470</e>
          <e type="operand" style="unit">N</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="461" width="120" height="30" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">m</e>
          <e type="operand">150</e>
          <e type="operand" style="unit">kg</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="509" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Total weight and mass of the loaded vehicle</p>
        </content>
      </text>
    </region>
    <region left="18" top="551" width="140" height="68" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">a</e>
          <e type="operand">0.447</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operand" style="unit">s</e>
          <e type="operand">2</e>
          <e type="operator" args="2">^</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="637" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Acceleration</p>
        </content>
      </text>
    </region>
    <region left="18" top="679" width="180" height="56" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">θ.ramp</e>
          <e type="operand">4.76</e>
          <e type="operand">π</e>
          <e type="operator" args="2">*</e>
          <e type="operand">180</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="753" width="150" height="56" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">θ</e>
          <e type="operand">5</e>
          <e type="operand">π</e>
          <e type="operator" args="2">*</e>
          <e type="operand">180</e>
          <e type="operator" args="2">/</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="827" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Incline angle: 4.76° (a 1:12 ramp) rounded up to 5° for the design calculation (angles in radians)</p>
        </content>
      </text>
    </region>
    <region left="18" top="869" width="100" height="30" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">SF</e>
          <e type="operand">1.5</e>
          <e type="operator" args="2">:</e>
        </input>
      </math>
    </region>
    <region left="18" top="917" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Safety factor</p>
        </content>
      </text>
    </region>
    <region left="18" top="969" width="740" height="32" color="#000000" fontSize="12">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 12px; font-weight: bold;">Forces at the Wheel</p>
        </content>
      </text>
    </region>
    <region left="18" top="1013" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Rolling resistance</p>
        </content>
      </text>
    </region>
    <region left="18" top="1055" width="300" height="35" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">F.R</e>
          <e type="operand">W</e>
          <e type="operand">C.f</e>
          <e type="operator" args="2">*</e>
          <e type="operand">θ</e>
          <e type="function" args="1">cos</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">N</e>
        </contract>
        <result action="numeric">
          <e type="operand">29.2881</e>
          <e type="operand" style="unit">N</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="18" top="1108" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Grade (incline) force</p>
        </content>
      </text>
    </region>
    <region left="18" top="1150" width="260" height="35" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">F.B</e>
          <e type="operand">W</e>
          <e type="operand">θ</e>
          <e type="function" args="1">sin</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">N</e>
        </contract>
        <result action="numeric">
          <e type="operand">128.1189</e>
          <e type="operand" style="unit">N</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="18" top="1203" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Acceleration force</p>
        </content>
      </text>
    </region>
    <region left="18" top="1245" width="220" height="35" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">F.A</e>
          <e type="operand">m</e>
          <e type="operand">a</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">N</e>
        </contract>
        <result action="numeric">
          <e type="operand">67.05</e>
          <e type="operand" style="unit">N</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="18" top="1298" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Total force</p>
        </content>
      </text>
    </region>
    <region left="18" top="1340" width="320" height="35" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">F.total</e>
          <e type="operand">F.R</e>
          <e type="operand">F.B</e>
          <e type="operator" args="2">+</e>
          <e type="operand">F.A</e>
          <e type="operator" args="2">+</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">N</e>
        </contract>
        <result action="numeric">
          <e type="operand">224.4571</e>
          <e type="operand" style="unit">N</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="18" top="1403" width="740" height="32" color="#000000" fontSize="12">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p style="font-size: 12px; font-weight: bold;">Torque</p>
        </content>
      </text>
    </region>
    <region left="18" top="1447" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Required wheel torque</p>
        </content>
      </text>
    </region>
    <region left="18" top="1489" width="248" height="35" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">T</e>
          <e type="operand">R</e>
          <e type="operand">F.total</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">N</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
        </contract>
        <result action="numeric">
          <e type="operand">10.7739</e>
          <e type="operand" style="unit">N</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
    <region left="18" top="1542" width="740" height="30" color="#000000" fontSize="10">
      <text lang="eng" width="740" fontFamily="Arial" fontSize="10">
        <content>
          <p>Design torque with the safety factor applied</p>
        </content>
      </text>
    </region>
    <region left="18" top="1584" width="262" height="35" color="#000000" fontSize="10">
      <math>
        <input>
          <e type="operand">T.design</e>
          <e type="operand">SF</e>
          <e type="operand">T</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">:</e>
        </input>
        <contract>
          <e type="operand" style="unit">N</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
        </contract>
        <result action="numeric">
          <e type="operand">16.1609</e>
          <e type="operand" style="unit">N</e>
          <e type="operand" style="unit">m</e>
          <e type="operator" args="2">*</e>
          <e type="operator" args="2">*</e>
        </result>
      </math>
    </region>
